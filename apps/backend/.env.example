# Copia aquest fitxer a ".env" dins d'aquesta mateixa carpeta (apps/backend).
# ".env" MAI es puja a git.

DATABASE_URL="file:./prisma/dev.db"
PORT=3000
NODE_ENV=development

# Clau mestra per xifrar les contrasenyes d'AimHarder guardades a la base de
# dades. Ha de ser un text llarg i aleatori. NO la perdis: si la canvies,
# deixaràs de poder desxifrar credencials ja guardades.
MASTER_KEY=canvia_aixo_per_un_text_llarg_i_aleatori
