# Copia aquest fitxer a ".env.local" i omple els teus valors reals.
# ".env.local" MAI es puja a git (ja està al .gitignore).

AIMHARDER_EMAIL=el_teu_email_de_login_a_aimharder
AIMHARDER_PASSWORD=la_teva_contrasenya_de_aimharder

# Opcionals: només cal si ja els coneixes (per exemple mirant les peticions
# de xarxa al navegador quan entres a AimHarder). Si no els poses, l'script
# de prova (Fase 0) et mostrarà la resposta del login perquè els puguis trobar.
AIMHARDER_BOX_SUBDOMAIN=
AIMHARDER_BOX_ID=
